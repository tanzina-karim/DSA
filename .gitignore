# Ignore directories and files generated by VSCode
.vscode/
.vscode/settings.json
.vscode/tasks.json
.vscode/launch.json

# Ignore directories generated by C++ build process
build/
bin/
obj/
out/

# Ignore compiled object files and libraries
*.o
*.obj
*.dll
*.lib
*.so
*.dylib
*.exe

# Ignore dependency resolution files
*.d
*.dep

# Ignore CMake build directories and files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Ignore temporary files
*.tmp
*.temp
*.log
*.pid
*.seed

# Ignore backup files
*~
*.bak
*.old
*.orig

# Ignore debug files
*.dbg
*.pdb

# Ignore other unnecessary files
*.swp
*.swo
*.DS_Store
Thumbs.db

# Ignore generated documentation
docs/generated/
